# MongoDB must be a replica set to support atomic schedule publication.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=nexus-rs
MONGODB_DATABASE=nexus
# Set a random value for persistent sessions. An empty value uses a process-local key.
JWT_SECRET=
# Used only when initializing an empty database. One administrator is created.
NEXUS_ADMIN_EMAIL=admin@nexus.demo
NEXUS_ADMIN_NAME=NEXUS Administrator
NEXUS_ADMIN_PASSWORD=NexusDemo!2026
