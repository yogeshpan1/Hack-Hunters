# MongoDB must support replica-set transactions. Values are configured locally.
MONGODB_URI=
MONGODB_DATABASE=
JWT_SECRET=
# Required only to bootstrap an empty database. No default password exists.
NEXUS_ADMIN_EMAIL=
NEXUS_ADMIN_NAME=
NEXUS_ADMIN_PASSWORD=
# Optional local role accounts, created only when each email and password are set.
NEXUS_SUPERADMIN_EMAIL=
NEXUS_SUPERADMIN_NAME=
NEXUS_SUPERADMIN_PASSWORD=
NEXUS_RTE_EMAIL=
NEXUS_RTE_NAME=
NEXUS_RTE_PASSWORD=
NEXUS_SSD_EMAIL=
NEXUS_SSD_NAME=
NEXUS_SSD_PASSWORD=
# Optional adapters; the shipped application uses deterministic assistance/demo email.
EMAIL_PROVIDER=demo
EMAIL_API_KEY=
LLM_API_KEY=

# Seed a clearly labelled reference-derived demo only into an empty operations workspace.
NEXUS_LOAD_DEMO=true

# Optional integrations adapted from Final.zip; disabled by default.
# Groq receives user questions only, never database records or credentials.
AI_PROVIDER=structured
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Set EMAIL_PROVIDER=resend to enable explicit reviewed live sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
